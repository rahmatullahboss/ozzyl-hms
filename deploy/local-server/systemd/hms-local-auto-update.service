[Unit]
Description=HMS local server auto update
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=user
WorkingDirectory=/opt/hms
Environment=HMS_LOCAL_UPDATE_BRANCH=main
ExecStart=/usr/bin/flock -n /tmp/hms-local-auto-update.lock /usr/bin/env bash scripts/local-server/update-stack.sh
