---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const PATIENT_APP_URL = import.meta.env.PUBLIC_PATIENT_APP_URL || 'https://app.ozzyl.com';
const PATIENT_LOGIN_URL = `${PATIENT_APP_URL}/patient/login`;
const PATIENT_DASHBOARD_URL = `${PATIENT_APP_URL}/patient/home`;
---

<Layout
  title="My Health by Ozzyl — Portable Health Record for Patients"
  description="একটি অ্যাকাউন্টে আপনার প্রেসক্রিপশন, টেস্ট রিপোর্ট, হেলথ কার্ড, ভিজিট হিস্ট্রি এবং পেশেন্ট-রিপোর্টেড ডেটা রাখুন।"
  pageType="my_health"
>
  <Navbar />

  <main class="mesh-bg min-h-screen bg-[radial-gradient(circle_at_top_right,_rgba(20,184,166,0.14),_transparent_30%),linear-gradient(180deg,_#f6fffe_0%,_#f8fafc_52%,_#ffffff_100%)] text-slate-900 overflow-hidden">

    <!-- Hero Section -->
    <section class="pt-28 pb-20 relative z-10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-[1.15fr_0.85fr] gap-10 items-center">
          <div>
            <div class="reveal-0 inline-flex items-center gap-2 rounded-full border border-teal-200 bg-white/80 px-4 py-2 text-sm font-semibold text-teal-700 shadow-sm backdrop-blur-md" data-i18n="myhealth.hero.badge">
              <span class="inline-flex h-2.5 w-2.5 rounded-full bg-teal-500 animate-pulse"></span>
              Your Personal Wellness Journal
            </div>

            <h1 class="reveal-1 mt-6 text-5xl md:text-6xl lg:text-[4rem] font-black tracking-tight leading-[1.05]">
              <span data-i18n="myhealth.hero.h1.1">আপনার হেলথ প্রোফাইল, </span>
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-600 via-emerald-500 to-cyan-600 relative inline-block">
                <span data-i18n="myhealth.hero.h1.highlight">আপনার সম্পূর্ণ নিয়ন্ত্রণে</span>
                <svg class="absolute -bottom-2 left-0 w-full h-3 text-teal-400/30" viewBox="0 0 100 10" preserveAspectRatio="none"><path d="M0 5 Q 50 10 100 5" stroke="currentColor" stroke-width="4" fill="none"/></svg>
              </span>
            </h1>

            <p class="reveal-2 mt-6 max-w-2xl text-lg md:text-xl text-slate-600 leading-relaxed font-medium" data-i18n="myhealth.hero.p">
              Ozzyl My Health account খুললে আপনার ডায়েট, লাইফস্টাইল অ্যাক্টিভিটি, টেস্ট রিপোর্ট এবং হেলথ কার্ড একই জায়গায় নিরাপদে থাকবে। স্বাস্থ্যকর জীবনযাপনের এক আধুনিক ও স্মার্ট পদ্ধতি।
            </p>

            <div class="reveal-3 mt-8 flex flex-col sm:flex-row gap-4">
              <a
                href={PATIENT_LOGIN_URL}
                data-track-event="my_health_login_click"
                data-track-label="myhealth.hero.cta.primary"
                data-track-location="hero_primary"
                class="group relative inline-flex items-center justify-center gap-2 rounded-2xl bg-teal-600 px-6 py-4 text-base font-bold text-white shadow-xl shadow-teal-600/20 hover:bg-teal-700 transition-all hover:scale-[1.02] active:scale-95 overflow-hidden"
              >
                <span class="absolute inset-0 bg-gradient-to-r from-white/0 via-white/20 to-white/0 translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-700"></span>
                <span data-i18n="myhealth.hero.cta.primary">Account খুলুন বা Login করুন</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 group-hover:translate-x-1 transition-transform" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
              </a>
              <a
                href={PATIENT_DASHBOARD_URL}
                data-track-event="my_health_dashboard_click"
                data-track-label="myhealth.hero.cta.secondary"
                data-track-location="hero_secondary"
                class="inline-flex items-center justify-center gap-2 rounded-2xl border-2 border-slate-200 bg-white/50 backdrop-blur-md px-6 py-4 text-base font-semibold text-slate-700 hover:border-teal-300 hover:text-teal-700 hover:bg-white transition-all active:scale-95"
              >
                <span data-i18n="myhealth.hero.cta.secondary">Dashboard খুলুন</span>
              </a>
            </div>

            <div class="reveal-3 mt-10 grid grid-cols-2 md:grid-cols-4 gap-4">
              <div class="glass-panel hover:-translate-y-1 transition-transform duration-300 rounded-2xl p-4 flex flex-col items-center text-center">
                <div class="text-3xl font-black text-teal-600">1</div>
                <p class="mt-2 text-xs font-bold text-slate-600 uppercase tracking-wide" data-i18n="myhealth.stat1">Account</p>
              </div>
              <div class="glass-panel hover:-translate-y-1 transition-transform duration-300 rounded-2xl p-4 flex flex-col items-center text-center">
                <div class="text-3xl font-black text-teal-600">QR</div>
                <p class="mt-2 text-xs font-bold text-slate-600 uppercase tracking-wide" data-i18n="myhealth.stat2">Health Card</p>
              </div>
              <div class="glass-panel hover:-translate-y-1 transition-transform duration-300 rounded-2xl p-4 flex flex-col items-center text-center">
                <div class="text-3xl font-black text-teal-600">24/7</div>
                <p class="mt-2 text-xs font-bold text-slate-600 uppercase tracking-wide" data-i18n="myhealth.stat3">Access</p>
              </div>
              <div class="glass-panel hover:-translate-y-1 transition-transform duration-300 rounded-2xl p-4 flex flex-col items-center text-center">
                <div class="text-2xl font-black text-teal-600 mt-1">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                  </svg>
                </div>
                <p class="mt-1 text-xs font-bold text-slate-600 uppercase tracking-wide" data-i18n="myhealth.stat4">Consent</p>
              </div>
            </div>
          </div>

          <!-- Hero Graphic -->
          <div class="relative reveal-2 mt-10 lg:mt-0 xl:scale-105 perspective-1000">
            <div class="hero-orb absolute -top-10 -right-10 h-64 w-64 rounded-full bg-teal-300/30 blur-3xl mix-blend-multiply"></div>
            <div class="hero-orb absolute -bottom-10 -left-10 h-64 w-64 rounded-full bg-emerald-300/30 blur-3xl mix-blend-multiply" style="animation-delay: -4s;"></div>

            <div class="ambient-shine relative rounded-[2.5rem] border border-white/60 bg-white/40 p-3 shadow-[0_30px_80px_rgba(15,118,110,0.15)] backdrop-blur-xl transform rotate-1 hover:rotate-0 transition-transform duration-700">
              <div class="rounded-[2.25rem] bg-white p-5 border border-slate-100">

                <!-- ID Card Visual -->
                <div class="rounded-[1.75rem] bg-gradient-to-br from-slate-900 via-teal-950 to-slate-900 p-6 text-white shadow-2xl relative overflow-hidden group">
                  <div class="absolute inset-0 bg-[url('https://grainy-gradients.vercel.app/noise.svg')] opacity-20 mix-blend-overlay"></div>
                  <div class="absolute top-0 right-0 w-32 h-32 bg-teal-500/20 rounded-full blur-3xl group-hover:bg-teal-400/30 transition-colors"></div>

                  <div class="relative z-10">
                    <div class="flex justify-between items-start">
                      <p class="text-[10px] uppercase tracking-[0.25em] font-bold text-teal-300/80" data-i18n="myhealth.card.title">Global Health Card</p>
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-teal-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm14 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" />
                      </svg>
                    </div>

                    <h2 class="mt-4 text-3xl font-black tracking-tight flex items-center gap-2">
                      <span class="bg-gradient-to-r from-white to-slate-300 bg-clip-text text-transparent">OZZYL</span>
                      <span class="text-teal-400 font-light translate-y-[2px]">-PHR</span>
                    </h2>

                    <div class="mt-8 grid grid-cols-2 gap-4 text-sm border-t border-white/10 pt-6">
                      <div>
                        <p class="text-slate-400 text-[10px] uppercase tracking-widest font-semibold">UHID</p>
                        <p class="mt-1 font-mono font-bold tracking-tight text-lg">OZ-000123</p>
                      </div>
                      <div>
                        <p class="text-slate-400 text-[10px] uppercase tracking-widest font-semibold">Status</p>
                        <div class="mt-2 inline-flex items-center gap-1.5 rounded-full bg-emerald-500/20 px-2.5 py-1 text-xs font-semibold text-emerald-400 border border-emerald-500/30">
                          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 flex-shrink-0 animate-pulse"></span>
                          <span data-i18n="myhealth.card.status">Active</span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="mt-4 grid gap-3 sm:grid-cols-2">
                  <div class="rounded-2xl bg-teal-50/50 p-4 border border-teal-100/50 hover:bg-teal-50 transition-colors cursor-pointer">
                    <div class="flex items-center gap-2 text-teal-700 mb-2">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
                      <p class="text-[11px] font-bold uppercase tracking-widest" data-i18n="myhealth.syncs.title">What syncs</p>
                    </div>
                    <ul class="space-y-1.5 text-[13px] text-slate-600 font-medium font-bengali">
                      <li class="flex items-start gap-1.5"><span class="text-teal-500 mt-0.5">•</span> <span data-i18n="myhealth.syncs.rx">প্রেসক্রিপশন & মেডিসিন</span></li>
                      <li class="flex items-start gap-1.5"><span class="text-teal-500 mt-0.5">•</span> <span data-i18n="myhealth.syncs.labs">ল্যাব রিপোর্টস</span></li>
                    </ul>
                  </div>
                  <div class="rounded-2xl bg-slate-50/80 p-4 border border-slate-100 hover:bg-slate-100 transition-colors cursor-pointer">
                    <div class="flex items-center gap-2 text-slate-700 mb-2">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" /></svg>
                      <p class="text-[11px] font-bold uppercase tracking-widest" data-i18n="myhealth.adds.title">What you add</p>
                    </div>
                    <ul class="space-y-1.5 text-[13px] text-slate-600 font-medium font-bengali">
                      <li class="flex items-start gap-1.5"><span class="text-slate-400 mt-0.5">•</span> <span data-i18n="myhealth.adds.vitals">Vitals & lifestyle</span></li>
                      <li class="flex items-start gap-1.5"><span class="text-slate-400 mt-0.5">•</span> <span data-i18n="myhealth.adds.docs">স্ক্যান ডকুমেন্টস</span></li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Bento Grid Section -->
    <section class="pb-32 pt-12 relative z-10 shadow-sm rounded-b-[4rem]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 auto-rows-min">
          <!-- Row 1: Big + Small -->
          <article class="bento-glow-card scroll-reveal md:col-span-2 rounded-[2rem] border border-slate-200/60 bg-white p-8 shadow-sm hover:shadow-xl transition-shadow flex flex-col justify-between overflow-hidden relative group">
            <div class="absolute inset-0 bg-gradient-to-br from-teal-50/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <div class="relative z-10">
              <div class="w-14 h-14 rounded-2xl bg-teal-100/50 flex items-center justify-center text-teal-600 icon-box-lift mb-6 border border-teal-200/50 shadow-inner">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
              </div>
              <h3 class="text-2xl font-black text-slate-900" data-i18n="myhealth.bento.records.title">এক জায়গায় সম্পূর্ণ রেকর্ড</h3>
              <p class="mt-3 text-base leading-relaxed text-slate-600 max-w-lg" data-i18n="myhealth.bento.records.desc">
                আপনার সব প্রেসক্রিপশন, টেস্ট রিপোর্ট, ভিজিট হিস্ট্রি আর আপলোড করা হেলথ ডকুমেন্টস একটি সিঙ্গেল অ্যাকাউন্টে সুন্দরভাবে সাজানো থাকবে। আর কোনো কাগজ হারানোর ভয় নেই।
              </p>
            </div>
          </article>

          <article class="bento-glow-card scroll-reveal delay-100 rounded-[2rem] border border-slate-200/60 bg-white p-8 shadow-sm hover:shadow-xl transition-shadow relative group">
             <div class="w-12 h-12 rounded-2xl bg-indigo-50 flex items-center justify-center text-indigo-600 icon-box-lift mb-5 border border-indigo-100/50">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2" /></svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900" data-i18n="myhealth.bento.portable.title">Portable Identity</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600" data-i18n="myhealth.bento.portable.desc">UHID/হেলথ কার্ড দেখিয়ে connected hospital-এ দ্রুত patient match করা সহজ হবে।</p>
          </article>

          <!-- Row 2: Small + Big -->
          <article class="bento-glow-card scroll-reveal delay-200 rounded-[2rem] border border-slate-200/60 bg-white p-8 shadow-sm hover:shadow-xl transition-shadow relative group">
             <div class="w-12 h-12 rounded-2xl bg-rose-50 flex items-center justify-center text-rose-600 icon-box-lift mb-5 border border-rose-100/50">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900" data-i18n="myhealth.bento.consent.title">100% Consent Control</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600" data-i18n="myhealth.bento.consent.desc">আপনার অনুমতি ছাড়া অন্য কোনো হাসপাতাল বা ডাক্তার আপনার ফুল রেকর্ড দেখতে পারবে না।</p>
          </article>

          <article class="bento-glow-card scroll-reveal delay-300 md:col-span-2 rounded-[2rem] border border-slate-200/60 bg-white p-8 shadow-sm hover:shadow-xl transition-shadow flex flex-col justify-between overflow-hidden relative group">
            <div class="absolute inset-0 bg-gradient-to-l from-indigo-50/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <div class="relative z-10 flex flex-col md:flex-row gap-6 items-center">
              <div>
                <div class="w-14 h-14 rounded-2xl bg-indigo-100/50 flex items-center justify-center text-indigo-600 icon-box-lift mb-6 border border-indigo-200/50 shadow-inner">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" /></svg>
                </div>
                <h3 class="text-2xl font-black text-slate-900" data-i18n="myhealth.bento.diagnosis.title">ডাক্তারের পরামর্শ গ্রহণে অভাবনীয় সুবিধা</h3>
                <p class="mt-3 text-base leading-relaxed text-slate-600 max-w-sm" data-i18n="myhealth.bento.diagnosis.desc">
                  আপনার সম্পূর্ণ মেডিকেল ইতিহাস চিকিৎসকের হাতের মুঠোয় থাকায়, আপনার শারীরিক অবস্থা বোঝা তার জন্য আরো সহজ হয়ে ওঠে—যা সঠিক পরামর্শ পাওয়ার পথ সুগম করে।
                </p>
              </div>
              <div class="flex-shrink-0 bg-indigo-50 border border-indigo-100 rounded-2xl p-5 w-full md:w-[220px]">
                <div class="flex items-baseline gap-1">
                  <span class="text-3xl font-black text-indigo-600">১০০%</span>
                  <span class="text-xl font-black text-indigo-600"></span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-indigo-500 ml-1" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 10.293a1 1 0 010 1.414l-6 6a1 1 0 01-1.414 0l-6-6a1 1 0 111.414-1.414L9 14.586V3a1 1 0 012 0v11.586l3.293-3.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                </div>
                <p class="mt-2 text-xs font-bold uppercase tracking-wider text-indigo-900/60 leading-tight" data-i18n="myhealth.bento.diagnosis.stat">আমাদের লক্ষ্য আপনার ডাক্তারের কাছে আপনার সঠিক ডেটা পৌঁছে দেওয়া</p>
              </div>
            </div>
          </article>

          <!-- Row 3: Big + Small -->
          <article class="bento-glow-card scroll-reveal delay-300 md:col-span-2 rounded-[2rem] border border-amber-500/20 bg-gradient-to-br from-[#111] to-[#1a1a1a] p-8 shadow-xl text-white flex flex-col justify-between relative group overflow-hidden">
            <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_right,_rgba(245,158,11,0.15),_transparent_50%)]"></div>
            <div class="relative z-10">
               <div class="w-14 h-14 rounded-2xl bg-amber-500/10 flex items-center justify-center text-amber-400 icon-box-lift mb-6 border border-amber-500/20 backdrop-blur-md">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
              </div>
              <div class="inline-flex items-center gap-1.5 rounded-full bg-amber-500/20 px-2.5 py-1 text-[10px] uppercase tracking-widest font-bold text-amber-400 border border-amber-500/30 mb-3" data-i18n="myhealth.bento.ai.badge">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse flex-shrink-0"></span>
                AI Integrated
              </div>
