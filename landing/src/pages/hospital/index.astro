---
import Layout from '../../layouts/Layout.astro';
import LanguageToggle from '../../components/LanguageToggle.astro';

const title = "Ozzyl HMS — Smart Hospital Management Software for Modern Healthcare";
const description = "Patient registration থেকে billing, pharmacy, lab, appointment ও reporting — সবকিছু এক প্ল্যাটফর্মে। হাসপাতাল পরিচালনা করুন আরও সহজ, দ্রুত ও স্মার্টভাবে।";
---

<Layout title={title} description={description} pageType="hospital">

  <style>
    .gradient-text {
      background: linear-gradient(135deg, #0891B2 0%, #059669 50%, #0d9488 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .glass-nav {
      background: rgba(255, 255, 255, 0.82);
      backdrop-filter: blur(20px) saturate(1.8);
      -webkit-backdrop-filter: blur(20px) saturate(1.8);
      border-bottom: 1px solid rgba(8, 145, 178, 0.08);
    }
    .glass-card {
      background: rgba(255, 255, 255, 0.6);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.8);
    }
    .soft-shadow {
      box-shadow: 0 4px 24px -2px rgba(8, 145, 178, 0.08), 0 1px 4px -1px rgba(8, 145, 178, 0.04);
    }
    .soft-shadow-lg {
      box-shadow: 0 20px 60px -12px rgba(8, 145, 178, 0.15), 0 4px 16px -4px rgba(8, 145, 178, 0.06);
    }
    .soft-hover {
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .soft-hover:hover {
      transform: translateY(-3px);
      box-shadow: 0 20px 60px -12px rgba(8, 145, 178, 0.18), 0 4px 16px -4px rgba(8, 145, 178, 0.08);
    }
    .cta-primary {
      background: linear-gradient(135deg, #0891B2, #0d9488);
      box-shadow: 0 8px 32px -4px rgba(8, 145, 178, 0.45), inset 0 1px 0 rgba(255,255,255,0.15);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .cta-primary:hover {
      box-shadow: 0 12px 40px -4px rgba(8, 145, 178, 0.55), inset 0 1px 0 rgba(255,255,255,0.2);
      transform: translateY(-2px);
    }
    .dashboard-card {
      background: linear-gradient(145deg, rgba(255,255,255,0.95), rgba(236,254,255,0.9));
      border: 1px solid rgba(8, 145, 178, 0.1);
      box-shadow: 0 8px 32px -8px rgba(8, 145, 178, 0.12);
    }
    .stat-glow {
      box-shadow: 0 0 0 1px rgba(8, 145, 178, 0.06), 0 4px 16px -4px rgba(8, 145, 178, 0.1);
    }
    .hero-mesh::before {
      content: '';
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 80% 60% at 10% 20%, rgba(8,145,178,0.08), transparent),
        radial-gradient(ellipse 60% 50% at 90% 15%, rgba(5,150,105,0.06), transparent),
        radial-gradient(ellipse 50% 40% at 50% 80%, rgba(13,148,136,0.05), transparent);
      pointer-events: none;
    }
    .grid-dot {
      background-image: radial-gradient(circle at 1px 1px, rgba(8,145,178,0.07) 1px, transparent 0);
      background-size: 28px 28px;
    }
    @keyframes float-slow {
      0%, 100% { transform: translateY(0) rotate(0deg); }
      50% { transform: translateY(-16px) rotate(1deg); }
    }
    @keyframes float-slow-reverse {
      0%, 100% { transform: translateY(0) rotate(0deg); }
      50% { transform: translateY(12px) rotate(-1deg); }
    }
    @keyframes pulse-ring {
      0% { transform: scale(1); opacity: 0.4; }
      100% { transform: scale(1.8); opacity: 0; }
    }
    .float-anim { animation: float-slow 7s ease-in-out infinite; }
    .float-anim-reverse { animation: float-slow-reverse 8s ease-in-out infinite; }
    .mobile-menu-open { display: flex !important; }

    @media (prefers-reduced-motion: reduce) {
      .float-anim, .float-anim-reverse { animation: none; }
    }
  </style>

  <main class="font-[Noto_Sans_Bengali] bg-[#f8fdff] text-[#164E63] min-h-screen overflow-x-hidden selection:bg-cyan-200 selection:text-cyan-900">

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- NAVBAR — Sticky glassmorphic with blur                       -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <nav class="fixed top-0 w-full z-50 glass-nav" id="main-nav">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-[72px]">
          <!-- Logo -->
          <a href="/hospital" class="flex items-center gap-2.5 group">
            <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-cyan-500 to-teal-500 flex items-center justify-center shadow-lg shadow-cyan-500/20 group-hover:shadow-cyan-500/30 transition-shadow">
              <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m-4-4h8m-10 4V8a2 2 0 012-2h8a2 2 0 012 2v12" />
              </svg>
            </div>
            <span class="text-xl font-bold text-gray-900 tracking-tight">Ozzyl<span class="text-cyan-600">HMS</span></span>
          </a>

          <!-- Desktop Nav -->
          <div class="hidden lg:flex items-center gap-1">
            <a href="#features" class="px-4 py-2 text-sm font-medium text-gray-600 hover:text-cyan-700 rounded-lg hover:bg-cyan-50/60 transition-all">Features</a>
            <a href="#modules" class="px-4 py-2 text-sm font-medium text-gray-600 hover:text-cyan-700 rounded-lg hover:bg-cyan-50/60 transition-all">Modules</a>
            <a href="#benefits" class="px-4 py-2 text-sm font-medium text-gray-600 hover:text-cyan-700 rounded-lg hover:bg-cyan-50/60 transition-all">Benefits</a>
            <a href="#faq" class="px-4 py-2 text-sm font-medium text-gray-600 hover:text-cyan-700 rounded-lg hover:bg-cyan-50/60 transition-all">FAQ</a>
            <div class="w-px h-5 bg-gray-200 mx-2"></div>
            <a href="#contact" class="cta-primary text-white px-5 py-2.5 rounded-xl text-sm font-semibold flex items-center gap-2">
              Book Free Demo
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
            </a>
          </div>

          <!-- Mobile Hamburger -->
          <button id="mobile-menu-btn" class="lg:hidden p-2 rounded-lg hover:bg-cyan-50 transition-colors" aria-label="Open menu">
            <svg class="w-6 h-6 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
          </button>
        </div>

        <!-- Mobile Menu -->
        <div id="mobile-menu" class="hidden lg:hidden flex-col pb-5 gap-1 border-t border-gray-100 pt-3">
          <a href="#features" class="px-4 py-3 text-sm font-medium text-gray-700 hover:bg-cyan-50 rounded-lg transition-colors">Features</a>
          <a href="#modules" class="px-4 py-3 text-sm font-medium text-gray-700 hover:bg-cyan-50 rounded-lg transition-colors">Modules</a>
          <a href="#benefits" class="px-4 py-3 text-sm font-medium text-gray-700 hover:bg-cyan-50 rounded-lg transition-colors">Benefits</a>
          <a href="#faq" class="px-4 py-3 text-sm font-medium text-gray-700 hover:bg-cyan-50 rounded-lg transition-colors">FAQ</a>
          <a href="#contact" class="cta-primary text-white px-5 py-3 rounded-xl text-sm font-semibold text-center mt-2">Book Free Demo</a>
        </div>
      </div>
    </nav>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- HERO SECTION — Split layout: copy left, dashboard right      -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <section class="relative pt-28 pb-16 lg:pt-36 lg:pb-28 overflow-hidden hero-mesh">
      <!-- Grid dot pattern -->
      <div class="absolute inset-0 grid-dot opacity-60"></div>
      <!-- Gradient orbs -->
      <div class="absolute top-10 left-[10%] w-[500px] h-[500px] bg-cyan-200/30 rounded-full blur-[100px] -z-10 float-anim"></div>
      <div class="absolute bottom-10 right-[5%] w-[400px] h-[400px] bg-teal-200/20 rounded-full blur-[80px] -z-10 float-anim-reverse"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">

          <!-- Left — Copy -->
          <div class="text-center lg:text-left">
            <!-- Badge -->
            <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-white/80 border border-cyan-100 shadow-sm mb-8">
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
              </span>
              <span class="text-xs font-semibold text-gray-600 tracking-wide uppercase">For Hospitals, Clinics & Diagnostic Centers</span>
            </div>

            <h1 class="text-4xl sm:text-5xl lg:text-[3.5rem] xl:text-6xl font-extrabold tracking-tight leading-[1.25] mb-6">
              <span class="text-gray-900">হাসপাতাল পরিচালনা করুন</span><br />
              <span class="gradient-text">আরও সহজ, দ্রুত ও স্মার্টভাবে</span>
            </h1>

            <p class="text-lg lg:text-xl text-gray-500 max-w-xl mx-auto lg:mx-0 mb-8 leading-relaxed font-[Figtree]">
              Patient registration থেকে billing, pharmacy, lab, appointment ও reporting — সবকিছু <strong class="text-gray-700">এক প্ল্যাটফর্মে।</strong>
            </p>

            <!-- CTA Buttons -->
            <div class="flex flex-col sm:flex-row gap-3 justify-center lg:justify-start mb-10">
              <a href="#contact" class="cta-primary text-white px-7 py-3.5 rounded-2xl font-semibold text-base flex items-center justify-center gap-2.5" data-track-event="cta_click" data-track-label="hero_book_demo" data-track-location="hero">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                Book a Free Demo
              </a>
              <a href="#modules" class="bg-white text-gray-700 border border-gray-200 px-7 py-3.5 rounded-2xl font-semibold text-base hover:bg-gray-50 hover:border-gray-300 transition-all flex items-center justify-center gap-2">
                Explore Features
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
              </a>
            </div>

            <!-- Trust indicators -->
            <div class="flex flex-wrap items-center gap-5 justify-center lg:justify-start text-sm text-gray-400 font-[Figtree]">
              <div class="flex items-center gap-1.5">
                <svg class="w-4 h-4 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
                <span>No credit card required</span>
              </div>
              <div class="flex items-center gap-1.5">
                <svg class="w-4 h-4 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
                <span>Setup in 24 hours</span>
              </div>
              <div class="flex items-center gap-1.5">
                <svg class="w-4 h-4 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
                <span>Free training included</span>
              </div>
            </div>
          </div>

          <!-- Right — Dashboard Mockup -->
          <div class="relative float-anim">
            <!-- Main dashboard card -->
            <div class="dashboard-card rounded-2xl p-5 lg:p-6 relative">
              <!-- Top bar -->
              <div class="flex items-center justify-between mb-5">
                <div class="flex items-center gap-2">
                  <div class="w-3 h-3 rounded-full bg-red-400"></div>
                  <div class="w-3 h-3 rounded-full bg-amber-400"></div>
                  <div class="w-3 h-3 rounded-full bg-emerald-400"></div>
                </div>
                <div class="text-xs font-semibold text-gray-400 font-[Figtree] tracking-wide">Ozzyl HMS Dashboard</div>
                <div class="flex items-center gap-1.5">
                  <div class="w-5 h-5 rounded bg-gray-100"></div>
                  <div class="w-5 h-5 rounded bg-gray-100"></div>
                </div>
              </div>

              <!-- Stats row -->
              <div class="grid grid-cols-4 gap-3 mb-5">
                <div class="stat-glow rounded-xl p-3 bg-white text-center">
                  <div class="text-[10px] text-gray-400 font-[Figtree] mb-1">Total Patients</div>
                  <div class="text-lg font-bold text-gray-900 font-[Figtree]">12,847</div>
                  <div class="text-[10px] text-emerald-500 font-semibold font-[Figtree]">+12.5%</div>
                </div>
                <div class="stat-glow rounded-xl p-3 bg-white text-center">
                  <div class="text-[10px] text-gray-400 font-[Figtree] mb-1">Today's Appt.</div>
                  <div class="text-lg font-bold text-gray-900 font-[Figtree]">48</div>
                  <div class="text-[10px] text-cyan-500 font-semibold font-[Figtree]">6 pending</div>
                </div>
                <div class="stat-glow rounded-xl p-3 bg-white text-center">
                  <div class="text-[10px] text-gray-400 font-[Figtree] mb-1">Revenue</div>
                  <div class="text-lg font-bold text-gray-900 font-[Figtree]">৳4.2L</div>
                  <div class="text-[10px] text-emerald-500 font-semibold font-[Figtree]">+8.3%</div>
                </div>
                <div class="stat-glow rounded-xl p-3 bg-white text-center">
                  <div class="text-[10px] text-gray-400 font-[Figtree] mb-1">Pending Bills</div>
                  <div class="text-lg font-bold text-gray-900 font-[Figtree]">23</div>
                  <div class="text-[10px] text-amber-500 font-semibold font-[Figtree]">৳1.1L due</div>
                </div>
              </div>

              <!-- Chart placeholder -->
              <div class="bg-white rounded-xl p-4 stat-glow mb-4">
                <div class="flex items-center justify-between mb-3">
                  <div class="text-xs font-semibold text-gray-700 font-[Figtree]">Revenue Overview</div>
                  <div class="flex gap-3 text-[10px] font-[Figtree] text-gray-400">
                    <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-cyan-400"></span>Income</span>
                    <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-emerald-400"></span>Expense</span>
                  </div>
                </div>
                <!-- SVG bar chart -->
                <svg viewBox="0 0 280 80" class="w-full" fill="none">
                  <rect x="5" y="30" width="18" height="50" rx="4" fill="#22d3ee" opacity="0.7" />
                  <rect x="5" y="55" width="18" height="25" rx="4" fill="#34d399" opacity="0.5" />
                  <rect x="40" y="15" width="18" height="65" rx="4" fill="#22d3ee" opacity="0.7" />
                  <rect x="40" y="45" width="18" height="35" rx="4" fill="#34d399" opacity="0.5" />
                  <rect x="75" y="25" width="18" height="55" rx="4" fill="#22d3ee" opacity="0.7" />
                  <rect x="75" y="50" width="18" height="30" rx="4" fill="#34d399" opacity="0.5" />
                  <rect x="110" y="10" width="18" height="70" rx="4" fill="#22d3ee" opacity="0.7" />
                  <rect x="110" y="40" width="18" height="40" rx="4" fill="#34d399" opacity="0.5" />
                  <rect x="145" y="20" width="18" height="60" rx="4" fill="#22d3ee" opacity="0.7" />
                  <rect x="145" y="48" width="18" height="32" rx="4" fill="#34d399" opacity="0.5" />
                  <rect x="180" y="5" width="18" height="75" rx="4" fill="#06b6d4" opacity="0.85" />
                  <rect x="180" y="35" width="18" height="45" rx="4" fill="#34d399" opacity="0.5" />
                  <rect x="215" y="18" width="18" height="62" rx="4" fill="#22d3ee" opacity="0.7" />
                  <rect x="215" y="42" width="18" height="38" rx="4" fill="#34d399" opacity="0.5" />
                  <rect x="250" y="28" width="18" height="52" rx="4" fill="#22d3ee" opacity="0.5" />
                  <rect x="250" y="50" width="18" height="30" rx="4" fill="#34d399" opacity="0.3" />
                </svg>
              </div>

              <!-- Bottom row: mini cards -->
              <div class="grid grid-cols-3 gap-3">
                <div class="stat-glow rounded-lg p-2.5 bg-white">
                  <div class="flex items-center gap-2 mb-1">
                    <div class="w-6 h-6 rounded bg-cyan-50 flex items-center justify-center">
                      <svg class="w-3.5 h-3.5 text-cyan-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>
                  </div>
                  <div class="text-[10px] font-semibold text-gray-700 font-[Figtree]">Lab Reports</div>
                  </div>
                  <div class="text-sm font-bold text-gray-900 font-[Figtree]">156</div>
                  <div class="text-[10px] text-emerald-500 font-[Figtree]">12 pending</div>
                </div>
                <div class="stat-glow rounded-lg p-2.5 bg-white">
                  <div class="flex items-center gap-2 mb-1">
                    <div class="w-6 h-6 rounded bg-teal-50 flex items-center justify-center">
                      <svg class="w-3.5 h-3.5 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>
                  </div>
                  <div class="text-[10px] font-semibold text-gray-700 font-[Figtree]">Pharmacy</div>
                  </div>
                  <div class="text-sm font-bold text-gray-900 font-[Figtree]">2,340</div>
                  <div class="text-[10px] text-amber-500 font-[Figtree]">8 low stock</div>
                </div>
                <div class="stat-glow rounded-lg p-2.5 bg-white">
                  <div class="flex items-center gap-2 mb-1">
                    <div class="w-6 h-6 rounded bg-emerald-50 flex items-center justify-center">
                      <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" /></svg>
                  </div>
                  <div class="text-[10px] font-semibold text-gray-700 font-[Figtree]">Doctors</div>
                  </div>
                  <div class="text-sm font-bold text-gray-900 font-[Figtree]">24</div>
                  <div class="text-[10px] text-cyan-500 font-[Figtree]">18 active</div>
                </div>
              </div>
            </div>

            <!-- Floating badge — top right -->
            <div class="absolute -top-3 -right-3 lg:-top-4 lg:-right-4 bg-white rounded-xl px-3 py-2 shadow-lg shadow-cyan-500/10 border border-cyan-100 float-anim-reverse">
              <div class="flex items-center gap-2">
                <div class="w-7 h-7 rounded-lg bg-emerald-50 flex items-center justify-center">
                  <svg class="w-4 h-4 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M12 7a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0V8.414l-4.293 4.293a1 1 0 01-1.414 0L8 10.414l-4.293 4.293a1 1 0 01-1.414-1.414l5-5a1 1 0 011.414 0L11 10.586 14.586 7H12z" clip-rule="evenodd" /></svg>
                </div>
                <div>
                  <div class="text-[10px] text-gray-400 font-[Figtree]">Monthly Growth</div>
                  <div class="text-sm font-bold text-emerald-600 font-[Figtree]">+23.5%</div>
                </div>
              </div>
            </div>

            <!-- Floating badge — bottom left -->
            <div class="absolute -bottom-3 -left-3 lg:-bottom-4 lg:-left-4 bg-white rounded-xl px-3 py-2 shadow-lg shadow-cyan-500/10 border border-cyan-100 float-anim">
              <div class="flex items-center gap-2">
                <div class="w-7 h-7 rounded-lg bg-cyan-50 flex items-center justify-center">
                  <svg class="w-4 h-4 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
                </div>
                <div>
                  <div class="text-[10px] text-gray-400 font-[Figtree]">Data Security</div>
                  <div class="text-sm font-bold text-cyan-600 font-[Figtree]">256-bit SSL</div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Trusted By bar -->
