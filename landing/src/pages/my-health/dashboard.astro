---
const PATIENT_APP_URL = import.meta.env.PUBLIC_PATIENT_APP_URL || 'https://app.ozzyl.com';
const PATIENT_DASHBOARD_URL = `${PATIENT_APP_URL}/patient/home`;
---

<!doctype html>
<html lang="bn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Redirecting to Patient Dashboard</title>
    <meta http-equiv="refresh" content={`0;url=${PATIENT_DASHBOARD_URL}`} />
  </head>
  <body style="font-family: system-ui, sans-serif; background: #f8fafc; color: #0f172a; display: grid; place-items: center; min-height: 100vh; margin: 0;">
    <main style="max-width: 36rem; text-align: center; padding: 2rem;">
      <h1 style="font-size: 1.5rem; margin-bottom: 0.75rem;">Patient dashboard-এ পাঠানো হচ্ছে</h1>
      <p style="margin-bottom: 1rem; line-height: 1.7;">
        logged-in patient experience এখন main Worker app-এ চলছে।
      </p>
      <a href={PATIENT_DASHBOARD_URL} style="display: inline-flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #0d9488, #0f766e); color: white; text-decoration: none; border-radius: 999px; padding: 0.9rem 1.4rem; font-weight: 600;">
        ড্যাশবোর্ড খুলুন
      </a>
    </main>
    <script is:inline define:vars={{ PATIENT_DASHBOARD_URL }}>
      window.location.replace(PATIENT_DASHBOARD_URL);
    </script>
  </body>
</html>
