---
const PATIENT_APP_URL = import.meta.env.PUBLIC_PATIENT_APP_URL || 'https://app.ozzyl.com';
const HMS_APP_URL = import.meta.env.PUBLIC_HMS_APP_URL || 'https://hms.ozzyl.com';
const PATIENT_LOGIN_URL = `${PATIENT_APP_URL}/patient/login`;
const HOSPITAL_LOGIN_URL = `${HMS_APP_URL}/login`;
---



<!-- Main Navbar -->
<nav class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-gray-100 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5">
        <img src="/favicon.svg" alt="Ozzyl" class="w-9 h-9 rounded-lg shadow-md shadow-cyan-500/20" />
        <span class="text-lg font-bold text-slate-800 tracking-tight" data-i18n="nav.brand">Ozzyl Health</span>
      </a>

      <!-- Desktop Nav Links -->
      <div class="hidden md:flex items-center gap-8">
        <a href="/about" class="text-sm font-medium text-gray-600 hover:text-primary-600 transition-colors duration-200" data-i18n="nav.about">আমাদের সম্পর্কে</a>
        <div class="h-4 w-px bg-gray-200"></div>
        <a href="/my-health" data-track-event="navbar_my_health_click" data-track-label="আমার স্বাস্থ্য" data-track-location="navbar_desktop" class="text-sm font-semibold text-teal-600 hover:text-teal-700 transition-colors duration-200 inline-flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
          <span data-i18n="nav.myhealth">আমার স্বাস্থ্য</span>
        </a>
        <a href="/hospital" data-track-event="navbar_hospital_page_click" data-track-label="Hospital Partner" data-track-location="navbar_desktop" class="text-sm font-semibold text-blue-600 hover:text-blue-700 transition-colors duration-200 inline-flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
          <span data-i18n="nav.hospital">Hospital Partner</span>
        </a>
      </div>

      <!-- CTA Buttons + Language Toggle -->
      <div class="flex items-center gap-3">

        <!-- EN / BN Toggle -->
        <div class="hidden sm:flex items-center gap-0.5 bg-gray-100 rounded-lg p-0.5">
          <button
            id="lang-btn-en"
            class="px-2.5 py-1 rounded-md text-xs font-bold text-gray-400 hover:text-gray-700 transition-all duration-150 cursor-pointer"
            aria-label="Switch to English"
          >EN</button>
          <button
            id="lang-btn-bn"
            class="px-2.5 py-1 rounded-md text-xs font-bold text-primary-600 hover:text-primary-700 transition-all duration-150 cursor-pointer"
            aria-label="Switch to Bengali"
          >বাং</button>
        </div>

        <a
          href={PATIENT_LOGIN_URL}
          data-track-event="navbar_patient_login_click"
          data-track-label="Patient Login"
          data-track-location="navbar_desktop"
          class="hidden sm:inline-flex items-center gap-2 px-4 py-2 border border-teal-200 text-teal-700 text-sm font-semibold rounded-lg bg-teal-50 hover:bg-teal-100 transition-colors duration-200 cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M15 12H3m0 0l4-4m-4 4l4 4m8-9h2a2 2 0 012 2v6a2 2 0 01-2 2h-2"/></svg>
          <span data-i18n="nav.patient.login">Patient Login</span>
        </a>
        <a
          href={HOSPITAL_LOGIN_URL}
          data-track-event="navbar_hospital_login_click"
          data-track-label="Hospital Login"
          data-track-location="navbar_desktop"
          class="inline-flex items-center gap-2 px-4 py-2 bg-emerald-500 text-white text-sm font-semibold rounded-lg shadow-sm hover:bg-emerald-600 transition-colors duration-200 cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          <span data-i18n="nav.hospital.login">Hospital Login</span>
        </a>

        <!-- Mobile menu button -->
        <button
          id="mobile-menu-btn"
          class="md:hidden p-2 rounded-lg text-gray-600 hover:bg-gray-100 hover:text-primary-600 transition-colors duration-200 cursor-pointer"
          aria-label="Open menu"
        >
          <svg id="menu-icon-open" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
          <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-gray-100">
    <div class="px-4 py-3 space-y-1">
      <a href="/about" class="flex items-center gap-2 text-sm font-medium text-gray-600 py-2.5 px-3 rounded-lg hover:bg-gray-50 hover:text-primary-600 transition-colors duration-200" data-i18n="nav.about">আমাদের সম্পর্কে</a>
      

      <div class="my-2 border-t border-gray-100"></div>
      <a href="/hospital" data-track-event="navbar_hospital_page_click" data-track-label="Hospital Partner" data-track-location="navbar_mobile" class="flex items-center gap-2 text-sm font-semibold text-blue-600 py-2.5 px-3 rounded-lg hover:bg-blue-50 transition-colors duration-200">
        <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
        <span data-i18n="nav.hospital">Hospital Partner</span>
      </a>
      <a href="/my-health" data-track-event="navbar_my_health_click" data-track-label="আমার স্বাস্থ্য (Patients)" data-track-location="navbar_mobile" class="flex items-center gap-2 text-sm font-semibold text-teal-600 py-2.5 px-3 rounded-lg hover:bg-teal-50 transition-colors duration-200">
        <svg class="w-5 h-5 text-teal-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
        <span data-i18n="nav.myhealth">আমার স্বাস্থ্য</span> (Patients)
      </a>
      <!-- Mobile language toggle -->
      <div class="flex items-center gap-2 py-2.5 px-3">
        <span class="text-xs text-gray-500 font-medium">Language:</span>
        <button id="lang-btn-en-mobile" onclick="document.getElementById('lang-btn-en').click()" class="px-2.5 py-1 rounded-md text-xs font-bold bg-gray-100 text-gray-600 hover:bg-primary-100 hover:text-primary-700 transition-colors cursor-pointer">EN</button>
        <button id="lang-btn-bn-mobile" onclick="document.getElementById('lang-btn-bn').click()" class="px-2.5 py-1 rounded-md text-xs font-bold bg-gray-100 text-gray-600 hover:bg-primary-100 hover:text-primary-700 transition-colors cursor-pointer">বাং</button>
      </div>

      <div class="pt-2 border-t border-gray-100 space-y-2">
        <a href={PATIENT_LOGIN_URL} data-track-event="navbar_patient_login_click" data-track-label="Patient Login" data-track-location="navbar_mobile" class="flex items-center justify-center gap-2 w-full px-4 py-3 border border-teal-200 bg-teal-50 text-teal-700 text-sm font-semibold rounded-lg hover:bg-teal-100 transition-colors duration-200"><span data-i18n="nav.patient.login">Patient Login</span></a>
        <a href={HOSPITAL_LOGIN_URL} data-track-event="navbar_hospital_login_click" data-track-label="Hospital Login" data-track-location="navbar_mobile" class="flex items-center justify-center gap-2 w-full px-4 py-3 bg-emerald-500 text-white text-sm font-semibold rounded-lg hover:bg-emerald-600 transition-colors duration-200"><span data-i18n="nav.hospital.login">Hospital Login</span></a>
      </div>
    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', isOpen);
    iconOpen?.classList.toggle('hidden', !isOpen);
    iconClose?.classList.toggle('hidden', isOpen);
  });

  // Close on link click
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    });
  });
</script>
