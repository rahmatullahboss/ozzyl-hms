---
const PATIENT_APP_URL = import.meta.env.PUBLIC_PATIENT_APP_URL || 'https://app.ozzyl.com';
const HMS_APP_URL = import.meta.env.PUBLIC_HMS_APP_URL || 'https://hms.ozzyl.com';
---


<!-- Footer -->
<footer id="contact" class="bg-gray-900 text-gray-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10">
      <!-- Brand -->
      <div>
        <div class="flex items-center gap-2 mb-4">
          <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-cyan-500 to-teal-600 flex items-center justify-center shadow-md shadow-cyan-500/20">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-white"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
          </div>
          <span class="text-lg font-bold text-white tracking-tight">Ozzyl Health</span>
        </div>
        <p class="text-sm text-gray-300 leading-relaxed mb-4 font-bengali" data-i18n="footer.desc">
          বাংলাদেশের জন্য তৈরি cloud-native হাসপাতাল ম্যানেজমেন্ট সিস্টেম। কোনো সার্ভার লাগবে না — ব্রাউজার থেকেই চলে।
        </p>
        <div class="flex gap-3">
          <a href="#" class="w-8 h-8 rounded-lg bg-gray-800 flex items-center justify-center hover:bg-primary-600 transition-colors duration-200 cursor-pointer" aria-label="LinkedIn">
            <svg class="w-4 h-4 text-gray-300 hover:text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href="#" class="w-8 h-8 rounded-lg bg-gray-800 flex items-center justify-center hover:bg-primary-600 transition-colors duration-200 cursor-pointer" aria-label="Facebook">
            <svg class="w-4 h-4 text-gray-300 hover:text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
        </div>
      </div>

      <!-- Product -->
      <div>
        <h4 class="text-sm font-semibold text-white uppercase tracking-wider mb-4" data-i18n="footer.col.product">Product</h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href="#features" class="hover:text-white transition-colors duration-200" data-i18n="footer.link.features">Features</a></li>

          <li><a href={`${HMS_APP_URL}/login`} class="hover:text-white transition-colors duration-200" data-i18n="footer.link.demo">Live Demo</a></li>
          <li><a href="#features" class="hover:text-white transition-colors duration-200" data-i18n="footer.link.ai">AI Assistant</a></li>
          <li><a href="#features" class="hover:text-white transition-colors duration-200" data-i18n="footer.link.tele">Telemedicine</a></li>
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h4 class="text-sm font-semibold text-white uppercase tracking-wider mb-4" data-i18n="footer.col.company">Company</h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href="#about" class="hover:text-white transition-colors duration-200" data-i18n="footer.link.founder">Founder Story</a></li>

          <li><a href="#contact" class="hover:text-white transition-colors duration-200" data-i18n="footer.link.contact">Contact</a></li>
          <li><a href="#" class="hover:text-white transition-colors duration-200" data-i18n="footer.link.privacy">Privacy Policy</a></li>
          <li><a href="#" class="hover:text-white transition-colors duration-200" data-i18n="footer.link.terms">Terms of Service</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="text-sm font-semibold text-white uppercase tracking-wider mb-4" data-i18n="footer.col.contact">Contact</h4>
        <ul class="space-y-3 text-sm">
          <li class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-primary-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <a href="mailto:contact@digitalcare.site" class="hover:text-white transition-colors duration-200">contact@digitalcare.site</a>
          </li>
          <li class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-emerald-400 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            <a href="https://wa.me/8801739416661" class="hover:text-white transition-colors duration-200" data-i18n="footer.whatsapp">WhatsApp: +880 1739-416661</a>
          </li>
          <li class="flex items-center gap-2.5 text-gray-300">
            <svg class="w-4 h-4 text-primary-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <span data-i18n="footer.location">Dhaka, Bangladesh</span>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Legal Disclaimer -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-8">
    <div class="bg-gray-800/40 rounded-xl p-5 border border-gray-700/50">
      <p class="text-xs text-gray-400 leading-relaxed text-justify" data-i18n="footer.disclaimer">
        Medical Disclaimer: Ozzyl Health is a healthcare technology platform, not a medical provider. Any AI-generated insights, summaries, or health tips provided on this platform are for informational purposes only and do not constitute professional medical advice, diagnosis, or treatment. The final clinical decision and liability always rest with the registered medical practitioner.
      </p>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-gray-800">
    <div class="max-w-7xl mx-auto px-4 py-5 flex flex-col sm:flex-row items-center justify-between text-xs text-gray-300 gap-2">
      <span class="flex items-center gap-1.5">
        <span data-i18n="footer.copy">© 2026 Ozzyl Health · Built with</span>
        <svg class="w-3.5 h-3.5 text-red-400 inline" fill="currentColor" viewBox="0 0 24 24"><path d="M12 21.593c-5.63-5.539-11-10.297-11-14.402 0-3.791 3.068-5.191 5.281-5.191 1.312 0 4.151.501 5.719 4.457 1.59-3.968 4.464-4.447 5.726-4.447 2.54 0 5.274 1.621 5.274 5.181 0 4.069-5.136 8.625-11 14.402z"/></svg>
        <span data-i18n="footer.copy.country">in Bangladesh</span>
      </span>
      <span class="flex items-center gap-1.5">
        <span>A product of</span>
        <a href="https://digitalcare.site" target="_blank" rel="noopener" class="text-primary-400 hover:text-white transition-colors duration-200">
          Digitalcare
        </a>
      </span>
      <span class="flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/></svg>
        <span data-i18n="footer.powered">Powered by Cloudflare</span>
      </span>
    </div>
  </div>
</footer>

<!-- WhatsApp Float -->
<a
  href="https://wa.me/8801739416661?text=Ozzyl%20Health%20সম্পর্কে%20জানতে%20চাই"
  target="_blank"
  rel="noopener"
  class="fixed bottom-6 right-6 w-14 h-14 bg-emerald-500 rounded-full flex items-center justify-center text-white shadow-xl hover:bg-emerald-600 hover:shadow-2xl hover:scale-105 transition-all duration-200 ease-out z-50 cursor-pointer"
  aria-label="Chat on WhatsApp"
>
  <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
</a>

<style>
  @media (prefers-reduced-motion: reduce) {
    * {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
    }
  }
</style>
