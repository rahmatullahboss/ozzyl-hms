---
---

<section class="py-24 bg-white overflow-hidden relative" id="ehr-system">
  <!-- Subtle background glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-cyan-50/50 rounded-full blur-3xl opacity-50 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-16">
      <p class="text-sm font-semibold text-primary-600 uppercase tracking-widest mb-3" data-i18n="ehr.badge">Our Main Differentiator</p>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-slate-900 mb-5 tracking-tight" data-i18n="ehr.title">
        AI-Powered Electronic Health Records (EHR)
      </h2>
      <p class="text-lg md:text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed" data-i18n="ehr.subtitle">
        Most hospitals struggle with fragmented patient data. Our intelligent EHR system uses AI to analyze past history instantly, dramatically increasing diagnosis accuracy.
      </p>
    </div>

    <div class="relative max-w-5xl mx-auto">
      <!-- Connection line for desktop -->
      <div class="hidden md:block absolute top-[50%] left-0 w-full h-[2px] bg-gradient-to-r from-gray-200 via-primary-300 to-emerald-200 z-0"></div>
      
      <div class="grid md:grid-cols-2 gap-8 lg:gap-16 relative z-10">
        
        <!-- The Problem: Without EHR -->
        <div class="bg-white rounded-3xl border border-gray-200 p-8 sm:p-10 shadow-sm hover:shadow-md transition-shadow duration-300 relative overflow-hidden group">
          <div class="absolute top-0 right-0 p-5 opacity-5 group-hover:opacity-10 transition-opacity duration-300">
            <svg class="w-32 h-32 text-slate-900" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          
          <div class="flex items-center gap-4 mb-8">
            <div class="w-14 h-14 bg-slate-100 rounded-2xl flex items-center justify-center border border-slate-200 box-shadow-sm">
              <svg class="w-7 h-7 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-slate-900" data-i18n="ehr.problem.title">Standard Hospitals</h3>
          </div>
          
          <p class="text-slate-600 mb-8 text-base leading-relaxed" data-i18n="ehr.problem.desc">
            Doctors often operate blindly due to missing previous history, leading to low diagnosis rates and medical errors.
          </p>
          
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-slate-400 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              <span class="text-slate-700 hover:text-slate-900 transition-colors" data-i18n="ehr.problem.point1">No access to past medical history</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-slate-400 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              <span class="text-slate-700 hover:text-slate-900 transition-colors" data-i18n="ehr.problem.point2">Low and inaccurate disease detection</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-slate-400 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              <span class="text-slate-700 hover:text-slate-900 transition-colors" data-i18n="ehr.problem.point3">Time wasted on redundant questions</span>
            </li>
          </ul>
        </div>

        <!-- The Solution: With AI EHR -->
        <div class="bg-gradient-to-br from-[#ECFEFF] to-[#F0FDF4] rounded-3xl border border-cyan-200 p-8 sm:p-10 shadow-xl shadow-cyan-900/5 relative overflow-hidden transform md:-translate-y-4 hover:shadow-2xl hover:shadow-cyan-900/10 transition-all duration-300">
          <div class="absolute top-0 right-0 p-5 opacity-10">
            <svg class="w-40 h-40 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="0.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          
          <div class="flex items-center gap-4 mb-8 relative">
            <div class="w-14 h-14 bg-gradient-to-tr from-[#0891B2] to-[#059669] rounded-2xl flex items-center justify-center shadow-lg shadow-cyan-500/30">
              <svg class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <h3 class="text-2xl font-extrabold text-slate-900" data-i18n="ehr.solution.title">Ozzyl AI EHR</h3>
            </div>
          </div>
          
          <p class="text-slate-700 mb-8 text-base font-medium leading-relaxed" data-i18n="ehr.solution.desc">
            An advanced system where AI aggregates a patient's complete timeline, surfacing critical insights instantly so doctors can diagnose with confidence.
          </p>
          
          <ul class="space-y-4 mb-10">
            <li class="flex items-start gap-3">
              <div class="mt-1 bg-cyan-100/80 rounded-full p-1.5 shrink-0">
                <svg class="w-3.5 h-3.5 text-cyan-700" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
              </div>
              <span class="text-slate-800 font-semibold" data-i18n="ehr.solution.point1">AI instantly reviews all past patient history</span>
            </li>
            <li class="flex items-start gap-3">
              <div class="mt-1 bg-cyan-100/80 rounded-full p-1.5 shrink-0">
                <svg class="w-3.5 h-3.5 text-cyan-700" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
              </div>
              <span class="text-slate-800 font-semibold" data-i18n="ehr.solution.point2">Skyrockets accurate diagnosis rates</span>
            </li>
            <li class="flex items-start gap-3">
              <div class="mt-1 bg-cyan-100/80 rounded-full p-1.5 shrink-0">
                <svg class="w-3.5 h-3.5 text-cyan-700" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
              </div>
              <span class="text-slate-800 font-semibold" data-i18n="ehr.solution.point3">Saves time through automated intelligent summaries</span>
            </li>
          </ul>

          <div class="bg-white/90 backdrop-blur-md rounded-2xl p-5 border border-cyan-100/50 shadow-sm relative z-10 group hover:-translate-y-1 transition-transform duration-300">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-emerald-100 rounded-full flex items-center justify-center shrink-0 border border-emerald-200/50">
                <svg class="w-6 h-6 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
              </div>
              <div>
                <p class="text-sm font-bold text-slate-900 mb-1" data-i18n="ehr.solution.insight.label">AI Assistant Insight</p>
                <p class="text-sm text-slate-600 leading-relaxed font-medium italic" data-i18n="ehr.solution.insight.text">"Patient reported similar chest pain in 2023. Previous ECG showed minor abnormalities. Recommending immediate cardiac enzyme test."</p>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</section>
